{
  "name": "doculens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:worker && bun --bun vite",
    "build": "bun run typecheck && bun run validate && bun run build:worker && bun --bun vite build && bun run scripts/package.ts && bun run verify",
    "build:debug": "MINI_APP_DEBUG=1 bun run build",
    "build:worker": "bun --bun vite build --config vite.worker.config.ts && bun run scripts/assemble-worker.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/workers/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "conformance": "node scripts/conformance.mjs",
    "validate": "node scripts/validate.mjs .",
    "verify": "node scripts/check_zip.mjs dist/package/app.zip",
    "pack": "node scripts/pack.mjs manifest.json dist/web dist/package"
  },
  "dependencies": {
    "@discourse-mini-app/sdk": "file:./vendor/sdk",
    "pdf-lib": "1.17.1",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "1.4.3",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
